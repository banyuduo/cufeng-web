# Apache / 阿里云虚拟主机：Next.js 静态导出
# 构建后随 public 复制到 out/，部署到站点根目录即可生效。

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 关闭 Apache 默认「目录补斜杠」301。
  # 阿里云虚拟主机上该 301 会错误跳转到 /usr/home/.../htdocs/... 内部路径。
  DirectorySlash Off

  # 根路径 → 中文首页
  RewriteRule ^$ /zh/ [R=301,L]

  # 目录无尾斜杠：仅内部重写，不对外 301（避免浏览器缓存错误跳转）
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+[^/])$ $1/ [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
